{
  "schema_version": "dual-ai-unit-coding-v1",
  "required_fields": {
    "evidence_id": "string copied exactly from CODING_PACKET.jsonl",
    "semantic_content": ["mechanism_only", "desired_behavior", "desired_human_state", "value_or_boundary", "conflict_or_failure_experience"],
    "temporal_scope": ["one_shot", "event_conditioned", "recurring", "persistent", "unknown"],
    "beneficiary": ["self", "household", "third_party", "unknown"],
    "accountable_party": ["self", "other", "shared", "unknown"],
    "failure_meaning": ["harm", "discomfort", "waste", "inconvenience", "security_failure", "care_lapse", "none", "unknown"],
    "delegation_acceptance": ["refused", "manual_only", "automation", "agent_control", "unknown"],
    "authorized_action_scope": ["explicit", "implicit", "absent", "conflicting"],
    "override_or_release": ["present", "absent", "unknown"],
    "purpose_uniqueness": ["unique", "one_of_multiple", "unknown"],
    "standing_responsibility_support": ["entails", "strongly_implies", "compatible_only", "contradicts", "irrelevant"],
    "candidate_responsibility": "device-independent maintenance objective or null",
    "confidence": ["high", "medium", "low"],
    "rationale": "source-grounded explanation, at most 18 words"
  }
}
