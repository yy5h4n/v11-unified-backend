{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://responsibility-benchmark.example/schemas/shared_types_v2.json",
  "title": "Harness V2 shared primitive types",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "public_identifier": {
      "allOf": [
        {"$ref": "#/$defs/identifier"},
        {"not": {"pattern": "(^|[_.:-])(canonical_contract|active_mask|evaluator|oracle|required_rooms|target_scope|witness|noop|gold)([_.:-]|$)"}}
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "canonical_decimal": {
      "type": "string",
      "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
    },
    "scalar": {
      "type": ["string", "number", "integer", "boolean", "null"]
    }
  },
  "type": "object",
  "additionalProperties": false
}
