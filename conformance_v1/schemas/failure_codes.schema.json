{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "failure_codes.schema.json",
  "title": "Failure code catalog",
  "description": "Machine-readable reason codes attached to every transition, exclusion and adjudication (normative doc section 2).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "name", "description", "stage", "severity"],
    "properties": {
      "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "stage": { "type": "string" },
      "severity": { "type": "string", "enum": ["blocker", "error", "warning"] }
    }
  }
}
