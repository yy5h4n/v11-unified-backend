{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "query.schema.json",
  "title": "Query",
  "description": "User-facing expression of the frozen responsibility; natural language only semantically entailed by the responsibility, with paraphrase set and equivalence verdict (normative doc section 6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "id", "schema_version", "version", "created_at", "statuses", "hash", "responsibility_id", "text", "paraphrase_set", "equivalence_verdict"],
  "properties": {
    "object_type": { "const": "Query" },
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string" },
    "statuses": { "$ref": "#/$defs/statuses" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "responsibility_id": { "type": "string" },
    "text": { "type": "string", "minLength": 1 },
    "paraphrase_set": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "equivalence_verdict": { "type": "string", "enum": ["bidirectional_entailed", "adds_obligation", "omits_clause", "unresolved"] }
  },
  "$defs": {
    "statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_status", "authorization_status", "physical_status", "release_status"],
      "properties": {
        "semantic_status": { "type": "string", "enum": ["provisional_ai_pilot", "human_validated", "critical_case_validated", "rejected_or_unresolved", "semantic_unknown", "out_of_scope"] },
        "authorization_status": { "type": "string", "enum": ["authorized_agent_control", "authorized_automation_only", "manual_only", "refused", "unknown"] },
        "physical_status": { "type": "string", "enum": ["unassigned", "candidate_binding", "positive_opportunity", "boundary_opportunity", "certified_no_opportunity", "unsupported"] },
        "release_status": { "type": "string", "enum": ["provisional", "frozen", "invalidated", "released"] },
        "preview_only": { "type": "boolean" }
      }
    }
  }
}
