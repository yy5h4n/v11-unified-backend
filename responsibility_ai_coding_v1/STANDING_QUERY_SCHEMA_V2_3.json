{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standing_intent_id",
    "responsibility_id",
    "canonical_query",
    "beneficiary",
    "lifecycle",
    "delegated_outcome",
    "duration_boundary",
    "profile_dependencies",
    "evidence_grounded_constraints",
    "configuration_variants_removed",
    "source_evidence_ids",
    "quality_flags",
    "generation_status",
    "rationale"
  ],
  "properties": {
    "standing_intent_id": {"type": "string", "pattern": "^si_.+"},
    "responsibility_id": {"type": "string", "pattern": "^rd_"},
    "canonical_query": {"type": "string", "minLength": 12},
    "beneficiary": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["MAINTAIN", "GUARD", "ACHIEVE_BY", "PREPARE_FOR", "RECOVER_AFTER_EVENT", "OPTIMIZE_UNDER"]},
    "delegated_outcome": {"type": "string", "minLength": 1},
    "duration_boundary": {"type": ["string", "null"]},
    "profile_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_grounded_constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "configuration_variants_removed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["operational_leakage", "oracle_leakage", "unsupported_invention", "ambiguous_outcome", "missing_boundary", "compound_responsibility", "canonical_name_mismatch", "needs_source_review"]}
    },
    "generation_status": {"enum": ["ready", "needs_review"]},
    "rationale": {"type": "string", "minLength": 1}
  }
}
