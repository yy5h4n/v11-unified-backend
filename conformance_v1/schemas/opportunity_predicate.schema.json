{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opportunity_predicate.schema.json",
  "title": "OpportunityPredicate",
  "description": "Backend-independent definition of relevant physical processes: required states/actions/observations/dynamics and positive/boundary/certified-no-op/unsupported conditions (normative doc sections 2 and 7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "id", "schema_version", "version", "created_at", "statuses", "hash", "contract_id", "required_state_variables", "required_observations", "legal_action_types", "authorization_boundaries", "required_dynamics", "exogenous_processes", "horizon", "observation_cadence", "action_sensitivity_criterion", "agent_information", "strata"],
  "properties": {
    "object_type": { "const": "OpportunityPredicate" },
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string" },
    "statuses": { "$ref": "#/$defs/statuses" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contract_id": { "type": "string" },
    "required_state_variables": { "type": "array", "items": { "type": "string" } },
    "required_observations": { "type": "array", "items": { "type": "string" } },
    "legal_action_types": { "type": "array", "items": { "type": "string" } },
    "authorization_boundaries": { "type": "string" },
    "required_dynamics": { "type": "array", "items": { "type": "string" } },
    "exogenous_processes": { "type": "array", "items": { "type": "string" } },
    "horizon": { "type": "integer", "minimum": 1 },
    "observation_cadence": { "type": "string" },
    "action_sensitivity_criterion": { "type": "string" },
    "agent_information": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_forecasts", "public_observation_vars", "authorized_actions"],
      "properties": {
        "has_forecasts": { "type": "boolean" },
        "public_observation_vars": { "type": "array", "items": { "type": "string" } },
        "authorized_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "strata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_opportunity", "boundary_opportunity", "certified_no_opportunity", "unsupported"],
      "properties": {
        "positive_opportunity": { "type": "string" },
        "boundary_opportunity": { "type": "string" },
        "certified_no_opportunity": { "type": "string" },
        "unsupported": { "type": "string" }
      }
    }
  },
  "$defs": {
    "statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_status", "authorization_status", "physical_status", "release_status"],
      "properties": {
        "semantic_status": { "type": "string", "enum": ["provisional_ai_pilot", "human_validated", "critical_case_validated", "rejected_or_unresolved", "semantic_unknown", "out_of_scope"] },
        "authorization_status": { "type": "string", "enum": ["authorized_agent_control", "authorized_automation_only", "manual_only", "refused", "unknown"] },
        "physical_status": { "type": "string", "enum": ["unassigned", "candidate_binding", "positive_opportunity", "boundary_opportunity", "certified_no_opportunity", "unsupported"] },
        "release_status": { "type": "string", "enum": ["provisional", "frozen", "invalidated", "released"] },
        "preview_only": { "type": "boolean" }
      }
    }
  }
}
