{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://responsibility-benchmark.example/schemas/session_protocol_v2.json",
  "title": "Harness V2 closed Agent session and sealed transcript",
  "$defs": {
    "canonicalPayload": {
      "type": "object",
      "required": ["media_type", "canonical_bytes_base64", "sha256"],
      "additionalProperties": false,
      "properties": {
        "media_type": {"const": "application/json;profile=rfc8785"},
        "canonical_bytes_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
        "sha256": {"$ref": "shared_types_v2.json#/$defs/sha256"}
      }
    },
    "stateReceipt": {
      "type": "object",
      "required": ["backend", "rules", "subscriptions", "wake_queue", "accounting"],
      "additionalProperties": false,
      "properties": {
        "backend": {"$ref": "shared_types_v2.json#/$defs/sha256"},
        "rules": {"$ref": "shared_types_v2.json#/$defs/sha256"},
        "subscriptions": {"$ref": "shared_types_v2.json#/$defs/sha256"},
        "wake_queue": {"$ref": "shared_types_v2.json#/$defs/sha256"},
        "accounting": {"$ref": "shared_types_v2.json#/$defs/sha256"}
      }
    },
    "inspectExchange": {
      "type": "object",
      "required": ["request", "response", "pre_state", "post_state"],
      "additionalProperties": false,
      "properties": {
        "request": {"$ref": "#/$defs/canonicalPayload"},
        "response": {"$ref": "#/$defs/canonicalPayload"},
        "pre_state": {"$ref": "#/$defs/stateReceipt"},
        "post_state": {"$ref": "#/$defs/stateReceipt"}
      }
    },
    "clarificationOutcome": {
      "oneOf": [
        {"type":"object","required":["status","answer","error_code"],"additionalProperties":false,"properties":{"status":{"const":"answered"},"answer":{"type":"string"},"error_code":{"type":"null"}}},
        {"type":"object","required":["status","answer","error_code"],"additionalProperties":false,"properties":{"status":{"const":"rejected"},"answer":{"type":"null"},"error_code":{"type":"string","minLength":1}}}
      ]
    },
    "clarificationExchange": {
      "type": "object",
      "required": ["question", "outcome", "pre_state", "post_state"],
      "additionalProperties": false,
      "properties": {
        "question": {"$ref": "#/$defs/canonicalPayload"},
        "outcome": {"$ref": "#/$defs/clarificationOutcome"},
        "pre_state": {"$ref": "#/$defs/stateReceipt"},
        "post_state": {"$ref": "#/$defs/stateReceipt"}
      }
    },
    "turnExchange": {
      "type": "object",
      "required": ["turn_id", "track", "callback", "pre_state", "inspects", "terminal_choice", "terminal_outcome", "post_state"],
      "additionalProperties": false,
      "properties": {
        "turn_id": {"$ref": "shared_types_v2.json#/$defs/identifier"},
        "track": {"enum": ["explicit_profile_control", "interactive_clarification"]},
        "callback": {"$ref": "#/$defs/canonicalPayload"},
        "pre_state": {"$ref": "#/$defs/stateReceipt"},
        "inspects": {"type": "array", "items": {"$ref": "#/$defs/inspectExchange"}},
        "terminal_choice": {"$ref": "#/$defs/canonicalPayload"},
        "terminal_outcome": {"oneOf": [{"$ref":"interaction_state_machine_v2.json#/$defs/transactionExchange"},{"$ref":"#/$defs/clarificationExchange"},{"type":"object","required":["kind"],"additionalProperties":false,"properties":{"kind":{"const":"yielded"}}}]},
        "post_state": {"$ref": "#/$defs/stateReceipt"}
      }
    },
    "transcriptRecord": {
      "type": "object",
      "required": ["sequence", "timestamp", "kind", "actor", "payload", "pre_state", "post_state"],
      "additionalProperties": false,
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "timestamp": {"$ref": "shared_types_v2.json#/$defs/timestamp"},
        "kind": {"enum": ["bootstrap_delivered", "callback_delivered", "inspect_request", "inspect_response", "terminal_choice", "tool_outcome", "clarification_request", "clarification_reply", "yield", "protocol_error", "termination_notice"]},
        "actor": {"enum": ["harness", "agent", "user_simulator", "backend"]},
        "payload": {"$ref": "#/$defs/canonicalPayload"},
        "pre_state": {"$ref": "#/$defs/stateReceipt"},
        "post_state": {"$ref": "#/$defs/stateReceipt"}
      }
    },
    "sealedSession": {
      "type": "object",
      "required": ["session_id", "agent_build_digest", "policy_config_digest", "episode_configuration", "episode_configuration_digest", "bootstrap", "bootstrap_audit", "turns", "records", "sealed", "transcript_digest"],
      "additionalProperties": false,
      "properties": {
        "session_id": {"$ref": "shared_types_v2.json#/$defs/identifier"},
        "agent_build_digest": {"$ref": "shared_types_v2.json#/$defs/sha256"},
        "policy_config_digest": {"$ref": "shared_types_v2.json#/$defs/sha256"},
        "episode_configuration": {"$ref":"interaction_state_machine_v2.json"},
        "episode_configuration_digest": {"$ref":"shared_types_v2.json#/$defs/sha256"},
        "bootstrap": {"$ref": "#/$defs/canonicalPayload"},
        "bootstrap_audit": {"$ref":"public_private_schema_v2.json#/$defs/audit_metadata"},
        "turns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/turnExchange"}},
        "records": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/transcriptRecord"}},
        "sealed": {"const": true},
        "transcript_digest": {"$ref": "shared_types_v2.json#/$defs/sha256"}
      }
    }
  },
  "$ref": "#/$defs/sealedSession"
}
