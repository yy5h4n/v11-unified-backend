! d2_fds_two_room_smoke_v1; {{DOOR_ACTION_COMMENT}}
&HEAD CHID='d2_fds_two_room' TITLE='Two-room smoke propagation door contrast' /
&TIME T_END=4.0 /
&MISC TMPA=20.0 /
&MESH IJK=40,20,20, XB=0.0,4.0,0.0,2.0,0.0,2.0 /
&REAC FUEL='PROPANE', SOOT_YIELD=0.01 /
! Native growing burner: 0.24 m2, reaching 120 kW at 60 seconds.
&SURF ID='BURNER', HRRPUA=500.0, RAMP_Q='FIRE_GROWTH' /
&RAMP ID='FIRE_GROWTH', T=0.0, F=0.0 /
&RAMP ID='FIRE_GROWTH', T=10.0, F=0.1 /
&RAMP ID='FIRE_GROWTH', T=30.0, F=0.5 /
&RAMP ID='FIRE_GROWTH', T=60.0, F=1.0 /
&OBST XB=0.60,1.00,0.70,1.30,0.00,0.05, SURF_ID='BURNER' /
! Partition between room 1 and room 2; the central panel is the door.
&OBST XB=1.95,2.05,0.00,0.70,0.00,2.00, SURF_ID='INERT' /
&OBST XB=1.95,2.05,1.30,2.00,0.00,2.00, SURF_ID='INERT' /
{{DOOR_PANEL}}
&VENT XB=0.00,0.00,0.40,1.60,0.00,1.80, SURF_ID='OPEN' /
&VENT XB=4.00,4.00,0.40,1.60,0.00,1.80, SURF_ID='OPEN' /
&DEVC ID='ROOM_B_TEMPERATURE', XYZ=3.50,1.00,1.00, QUANTITY='TEMPERATURE' /
&DEVC ID='ROOM_B_VISIBILITY', XYZ=3.50,1.00,1.00, QUANTITY='VISIBILITY' /
&DEVC ID='ROOM_B_VELOCITY', XYZ=2.50,1.00,1.00, QUANTITY='VELOCITY' /
&TAIL /
